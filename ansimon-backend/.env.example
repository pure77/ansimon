SPRING_PROFILES_ACTIVE=local

SERVER_PORT=8080

MYSQL_URL=jdbc:mysql://localhost:3306/ansimon?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=ansimon
MYSQL_PASSWORD=ansimon

OPENAI_API_KEY=
SPRING_AI_VECTORSTORE_TYPE=none

KMA_BASE_URL=https://apis.data.go.kr
KMA_API_KEY=
SHELTER_BASE_URL=https://apis.data.go.kr
SHELTER_API_KEY=
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_API_KEY=

ML_API_BASE_URL=http://localhost:8100

CONNECTION_BASE_URL=http://localhost:7000
# 로컬 실행: 연결 서버 .env 의 CONNECTION_API_KEY 와 반드시 같은 값으로 채운다 (비면 호출이 막힌다).
CONNECTION_API_KEY=
# /internal/** 호출을 허용할 키 (32자 이상, openssl rand -hex 32). 연결 서버의 ANSIMON_BACKEND_TOKEN 과 같은 값.
# 교체할 때는 "새키,이전키" 로 잠시 둘 다 넣었다가, 연결 서버를 새 키로 바꾼 뒤 이전 키를 지운다.
# 로컬 기본값은 local-dev-internal-key-change-me-0000 이며, 연결 서버의 ANSIMON_BACKEND_TOKEN 을
# 이 값(또는 여기 적은 키 중 하나)으로 맞춰야 한다.
INTERNAL_API_KEYS=
# 관리자 JWT 서명 키. 32바이트 이상 (openssl rand -hex 32). 바꾸면 발급된 토큰이 모두 무효가 된다.
ANSIMON_JWT_SECRET=
ANSIMON_ACCESS_TOKEN_TTL=1h
# admin_account 가 비어 있을 때만 첫 관리자를 만든다. 계정이 생긴 뒤에는 지워도 된다. 비밀번호 12자 이상.
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
CONNECTION_WEBCLIENT_RESPONSE_TIMEOUT=120s
